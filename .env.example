# Kaggle API credentials (for downloading the real dataset)
# Download from: https://www.kaggle.com/settings/account > API > Create New Token
KAGGLE_USERNAME=
KAGGLE_KEY=

# OpenAI API key (optional - enables LLM judge and enhanced generation)
OPENAI_API_KEY=

# LLM Judge configuration
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
